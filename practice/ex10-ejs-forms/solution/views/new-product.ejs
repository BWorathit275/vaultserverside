<%- include('partials/header', { title }) %>
<h1>Add product</h1>

<% if (errors.length > 0) { %>
  <ul class="errors">
    <% errors.forEach((error) => { %>
      <li><%= error %></li>
    <% }) %>
  </ul>
<% } %>

<form method="POST" action="/products">
  <label>Name <input type="text" name="name" value="<%= values.name %>"></label>
  <label>Price <input type="number" name="price" step="0.01" value="<%= values.price %>"></label>
  <label>Description <textarea name="description"><%= values.description %></textarea></label>
  <button type="submit">Save</button>
</form>
<%- include('partials/footer') %>
