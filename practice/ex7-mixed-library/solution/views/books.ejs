<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Library</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <% if (user) { %>
    <p>Logged in as <b><%= user.username %></b> (<%= user.role %>)</p>
  <% } else { %>
    <p>Not logged in</p>
  <% } %>
  <h1>Library</h1>
  <table>
    <tr><th>Title</th><th>Author</th><th>Copies</th></tr>
    <% books.forEach((book) => { %>
      <tr class="<%= book.copies === 0 ? 'out' : '' %>">
        <td><%= book.title %></td>
        <td><%= book.author %></td>
        <td><%= book.copies === 0 ? "Out of stock" : book.copies %></td>
      </tr>
    <% }) %>
  </table>
</body>
</html>
